{
  "name": "transcribevideototext-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client, CLI, and MCP server for the VideoToText transcription API.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.8.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
